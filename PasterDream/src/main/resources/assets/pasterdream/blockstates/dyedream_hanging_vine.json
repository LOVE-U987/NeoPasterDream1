{
  "multipart": [
    { "when": { "east": "true" }, "apply": { "model": "pasterdream:block/dyedream_hanging_vine", "y": 90, "uvlock": true } },
    { "when": { "north": "true" }, "apply": { "model": "pasterdream:block/dyedream_hanging_vine", "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "pasterdream:block/dyedream_hanging_vine", "y": 180, "uvlock": true } },
    { "when": { "up": "true" }, "apply": { "model": "pasterdream:block/dyedream_hanging_vine", "x": 270, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "pasterdream:block/dyedream_hanging_vine", "y": 270, "uvlock": true } }
  ]
}
