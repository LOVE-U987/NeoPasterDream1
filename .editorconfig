root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
charset = utf-8
trim_trailing_whitespace = false
max_line_length = off

# Match the batch-file exception in the code style guide
[*.bat]
end_of_line = crlf
