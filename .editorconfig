root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,json,yaml,yml,xml,gradle}]
charset = utf-8

[*.md]
charset = utf-8
trim_trailing_whitespace = false

[*.nbt]
charset = binary

[*.png]
charset = binary

[*.jpg]
charset = binary

[*.gif]
charset = binary
